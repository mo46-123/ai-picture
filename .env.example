# 复制为 .env 后按需修改（.env 不会被提交到 Git）
# Copy to .env and edit. Every value here is optional.

# ---- 服务 ----
HOST=127.0.0.1          # 想用手机访问电脑上的服务就改成 0.0.0.0
PORT=8000
MAX_SIDE=2048           # 处理时照片长边的最大像素
MAX_UPLOAD_MB=15

# ---- 人脸模型 ----
# 国内网络下载不了 Google 的地址时，换成镜像地址，或手动放到 models/face_landmarker.task
# FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
AUTO_DOWNLOAD_MODEL=1

# ---- AI 写真（可选，配置任意一个即可解锁）----
AI_PROVIDER=auto        # auto / dashscope / volcengine / gemini / none
AI_LABEL=1              # 给 AI 结果加「AI生成」角标和元数据
AI_RATE_LIMIT=10/hour   # 每个 IP 的 AI 写真次数上限（0 = 不限制）

# 阿里云百炼（国内直连）
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_MODEL=qwen-image-2.1-pro        # 也可以填 qwen-image-2.0-pro / qwen-image-3.0 等，以控制台为准
# DASHSCOPE_WORKSPACE_ID=                    # 控制台给的是 {WorkspaceId}.cn-beijing.maas.aliyuncs.com 这种地址时填写

# 火山引擎方舟（国内直连）
# ARK_API_KEY=...
# ARK_MODEL=doubao-seedream-4-5-251128

# Google Gemini（国内需要代理）
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.1-flash-image
